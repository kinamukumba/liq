# ====================================================================
# LIQ SAAS - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Modelo de configuração para implantação em servidores de produção
# ====================================================================

# Ambiente da Aplicação
APP_ENV=production
APP_NAME="LIQ SAAS"
APP_DEBUG=false

# Prefixo Oficial de Rotas da API (api.liq.ao/app-api)
API_PREFIX=/app-api

# Domínios Oficiais da Infraestrutura Multi-Subdomínio
DOMAIN_LANDING="liq.ao"
DOMAIN_APP="app.liq.ao"
DOMAIN_API="api.liq.ao"
DOMAIN_BACKOFFICE="backoffice.liq.ao"

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS="https://liq.ao,https://app.liq.ao,https://backoffice.liq.ao"

# Configurações do Banco de Dados MySQL de Produção
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=liq_saas_prod
DB_USER=liq_db_user
DB_PASS=SUA_SENHA_SEGURA_AQUI
DB_CHARSET=utf8mb4

# Segurança e Criptografia
JWT_SECRET=GENERATE_A_64_CHAR_HEX_SECRET_FOR_PRODUCTION
TOKEN_EXPIRY_SECONDS=86400
SESSION_COOKIE_NAME=liq_auth_sess
DEVICE_COOKIE_NAME=liq_d_id
