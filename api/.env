# ====================================================================
# LIQ SAAS - ENVIRONMENT CONFIGURATION (.env)
# Arquivo de configuração de ambiente e infraestrutura da plataforma
# ====================================================================

# Ambiente da Aplicação (development | staging | production)
APP_ENV=development
APP_NAME="LIQ SAAS"
APP_DEBUG=true

# Prefixo Oficial de Rotas da API (Conforme arquitetura de produção api.liq.ao/app-api)
API_PREFIX=/app-api

# Domínios Oficiais da Infraestrutura Multi-Subdomínio
DOMAIN_LANDING="liq.ao"
DOMAIN_APP="app.liq.ao"
DOMAIN_API="api.liq.ao"
DOMAIN_BACKOFFICE="backoffice.liq.ao"

# CORS Allowed Origins (Separados por vírgula)
# Em desenvolvimento inclui localhost; em produção somente os subdomínios autorizados
CORS_ALLOWED_ORIGINS="http://localhost,http://127.0.0.1,https://liq.ao,https://app.liq.ao,https://backoffice.liq.ao"

# Configurações do Banco de Dados MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=liq_saas
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Segurança e Criptografia
JWT_SECRET=liq_saas_sec_key_production_random_hash_98234710293847
TOKEN_EXPIRY_SECONDS=86400
SESSION_COOKIE_NAME=liq_auth_sess
DEVICE_COOKIE_NAME=liq_d_id
